{
  "name": "dsh-restart",
  "version": "1.0.0",
  "private": true,
  "description": "【需要配套外壳补丁，单装本插件不生效】在 DSH Desktop 侧边栏底部加一个「重启」按钮：走托盘退出同一条原生确认与优雅关闭，然后重新拉起。补丁脚本在本仓库 shell-patch/。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}